{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "lint": "eslint . --cache",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:all": "npm run typecheck && tsc --noEmit -p tsconfig.test.json",
    "verify:db-identity": "node scripts/db/verify-database-identity.js",
    "verify": "npm run verify:db-identity && npm run typecheck && npm run lint && npm run test:unit",
    "verify:full": "npm run verify:db-identity && npm run typecheck:all && npm run lint && npm run build && npm run test:unit && npm run test:integration",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/components tests/features",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "electron:start": "electron electron/main.cjs",
    "electron:build:win": "vite build && electron-builder --config electron/electron-builder.json --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.10",
    "@testing-library/dom": "^10.4.1"
  }
}
